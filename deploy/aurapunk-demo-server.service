[Unit]
Description=AuraPunk demo server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=aurapunk
Group=aurapunk
WorkingDirectory=/home/aurapunk/demo-server
Environment=HOME=/home/aurapunk
Environment=NODE_ENV=demo
Environment=HOST=127.0.0.1
Environment=PORT=4100
ExecStart=/usr/bin/node /home/aurapunk/demo-server/server.js
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
