[Unit]
Description=Vibe Kanban Alternative demo
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=aurapunk
Group=aurapunk
WorkingDirectory=/opt/vibe-kanban-demo
Environment=HOME=/home/aurapunk
Environment=XDG_DATA_HOME=/home/aurapunk/.local/share
Environment=PATH=/home/aurapunk/.opencode/bin:/home/aurapunk/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=HOST=127.0.0.1
Environment=BACKEND_PORT=3100
Environment=PREVIEW_PROXY_PORT=3103
Environment=VK_DISABLE_BROWSER_OPEN=1
Environment=MEM0_URL=http://127.0.0.1:8000
EnvironmentFile=-/etc/aurapunk/mem0.env
Environment=VK_ALLOWED_ORIGINS=http://192.168.1.168:3000,http://localhost:3000
Environment=RUST_LOG=info
ExecStart=/opt/vibe-kanban-demo/target/release/server
Restart=on-failure
RestartSec=5
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
