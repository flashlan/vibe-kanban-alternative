# ==========================================
# 🌐 CORE SERVER CONFIGURATION
# ==========================================
PORT=3000
HOST=localhost
NODE_ENV=development
AURAPUNK_CLOUD_URL=https://aurapunk-cloud.datapoint.chatgpt.site

# ==========================================
# 🧠 MEM0 LONG-TERM MEMORY SETTINGS
# ==========================================
MEM0_ENABLED=true
# mem0_vk (self-hosted) or mem0_platform (official Mem0 API)
AURAPUNK_MEM0_ADAPTER=mem0_vk
MEM0_API_KEY=your_mem0_api_key_here
# Qdrant settings are consumed by the self-hosted adapter.
# QDRANT_URL=https://your-cluster.cloud.qdrant.io
# QDRANT_API_KEY=your_qdrant_api_key_here
# MEM0_EMBEDDING_DIMS=384
# If running local embeddings/vector store:
# MEM0_VECTOR_STORE=qdrant
# MEM0_HOST=http://localhost:6333

# ==========================================
# 🤖 AGENT API KEYS & RUNTIMES
# ==========================================
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=...

# Antigravity (AGY) Specific Settings
AGY_CLI_PATH=/usr/local/bin/agy
AGY_DEFAULT_TEMPERATURE=0.2

# ==========================================
# 📊 METRICS & TELEMETRY
# ==========================================
ENABLE_METRICS_DASHBOARD=true
METRICS_STORAGE_PATH=./data/metrics.sqlite

# ==========================================
# 💾 BACKUP CONFIGURATION
# ==========================================
BACKUP_ENABLED=true
BACKUP_INTERVAL_MINUTES=30
BACKUP_STORAGE_PATH=./backups
